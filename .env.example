# Скопируй в .env и заполни. .env никуда не отправляй и не клади в git.

# Hyperliquid: основной адрес (где деньги) + ключ API-кошелька (agent): торговать может, выводить нет.
# Agent создаётся на app.hyperliquid.xyz -> More -> API.
HL_ACCOUNT_ADDRESS=0x...
HL_AGENT_PRIVATE_KEY=0x...

# Lighter: индекс аккаунта/субаккаунта, индекс API-ключа (2..254) и его приватный ключ (не кошелька!)
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# Telegram: токен от @BotFather и твой chat id (узнать: напиши боту, затем открой
# https://api.telegram.org/bot<TOKEN>/getUpdates и возьми message.chat.id). Несколько — через запятую.
TG_BOT_TOKEN=
TG_CHAT_ID=
# Если Telegram недоступен напрямую (ошибка SSL / таймауты) — локальный HTTP-прокси VPN-клиента:
# TG_PROXY=http://127.0.0.1:12334
